# npm install (не npm ci) в Dockerfile каждый раз резолвит зависимости заново —
# закоммиченный lock-файл рискует зафиксировать платформо-специфичные бинарники
# (rollup/esbuild) с машины разработчика, а не с Alpine/musl, где реально собирается образ
web/package-lock.json
