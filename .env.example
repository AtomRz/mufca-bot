DISCORD_TOKEN=your_discord_bot_token
CHANNEL_NAME=general

# Web dashboard (port 8585) Basic Auth. If either is left empty, the dashboard
# is served WITHOUT authentication — anyone with network access to the port
# can view live positions and change bot settings. Set both to protect it.
WEB_USERNAME=
WEB_PASSWORD=

# Optional — Android push notifications via Firebase Cloud Messaging. Leave unset
# to disable (signals still show up in Discord and the web dashboard as usual).
# Path INSIDE the container to the Firebase service account JSON key — mount it
# as a volume, never bake it into the image or commit it (see .gitignore).
FIREBASE_CREDENTIALS_PATH=/app/data/firebase-credentials.json

# Optional — enables the on-chain bias module (confidence/TP/SL/leverage adjustments).
# If either key is missing, on-chain analysis is automatically disabled.
ETHERSCAN_API_KEY=
COINGECKO_API_KEY=
